{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["context7", "playwright"],
  "permissions": {
    "allow": [
      "Bash(./scripts/init.sh:*)",
      "Bash(./scripts/stop.sh:*)",
      "Bash(./scripts/run-gates.mjs:*)",
      "Bash(./scripts/migrate-dev.sh:*)",
      "Bash(node .claude/skills/*:*)",
      "Bash(npx playwright-cli:*)",
      "Bash(playwright-cli:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run:*)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
